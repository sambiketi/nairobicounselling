{% extends "base.njk" %}
{% block title %}Contact Us - Nairobi Counseling Center{% endblock %}
{% block head %}
<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem; }
  .map-container { width: 100%; height: 400px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1); border: 3px solid #C9A87C; }
  .map-container iframe { width: 100%; height: 100%; border: 0; }
  .location-info { background: #f8f9fa; padding: 2rem; border-radius: 12px; border-left: 4px solid #C9A87C; }
  .location-info h3 { color: #4A3528; margin-bottom: 0.5rem; }
  .location-info p { color: #666; margin-bottom: 0.5rem; }
  .open-map-link { display: inline-block; margin-top: 1rem; padding: 0.8rem 1.5rem; background: linear-gradient(145deg, #C9A87C, #B8966A); color: #4A3528; text-decoration: none; border-radius: 8px; font-weight: bold; transition: all 0.3s ease; }
  .open-map-link:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(201, 168, 124, 0.4); }
  .whatsapp-link { display: inline-block; margin-top: 0.5rem; padding: 0.5rem 1.2rem; background: #25D366; color: white; text-decoration: none; border-radius: 8px; font-weight: bold; transition: all 0.3s ease; }
  .whatsapp-link:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4); }
  .whatsapp-link i { margin-right: 0.5rem; }
  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } .map-container { height: 300px; } }
</style>
{% endblock %}
{% block content %}
<section class="about-page">
  <h1>Contact Us</h1>
  <p style="text-align:center; color: #666; margin-bottom: 2rem;">We're here to support you</p>
  <div style="max-width: 1000px; margin: 0 auto;">
    <div class="contact-grid">
      <div class="location-info">
        <h3><i class="fas fa-map-marker-alt" style="color: #C9A87C;"></i> Location</h3>
        <p>{{ contactSettings.address or 'Nairobi, Kenya' }}</p>
        <h3 style="margin-top: 1.5rem;"><i class="fas fa-phone" style="color: #C9A87C;"></i> Phone</h3>
        <p>{{ contactSettings.phone or '+254 700 000 000' }}</p>
        <p style="color: #666;">Crisis Hotline: {{ contactSettings.crisisHotline or '1190' }}</p>
        <h3 style="margin-top: 1.5rem;"><i class="fas fa-envelope" style="color: #C9A87C;"></i> Email</h3>
        <p>{{ contactSettings.email or 'info@nairobiologycounseling.com' }}</p>
        <p style="color: #666;">Support: {{ contactSettings.supportEmail or 'support@nairobiologycounseling.com' }}</p>
        <h3 style="margin-top: 1.5rem;"><i class="fab fa-whatsapp" style="color: #25D366;"></i> WhatsApp</h3>
        {% if contactSettings.whatsappNumber %}
          <a href="https://wa.me/{{ contactSettings.whatsappNumber }}" target="_blank" class="whatsapp-link">
            <i class="fab fa-whatsapp"></i> Chat with Us
          </a>
        {% endif %}
        <h3 style="margin-top: 1.5rem;"><i class="fas fa-clock" style="color: #C9A87C;"></i> Hours</h3>
        <p>Mon-Fri: {{ contactSettings.hoursWeekday or '8:00 AM - 8:00 PM' }}</p>
        <p style="color: #666;">Sat: {{ contactSettings.hoursSaturday or '9:00 AM - 5:00 PM' }}</p>
        <p style="color: #666;">Sun: {{ contactSettings.hoursSunday or 'Closed' }}</p>
        {% if contactSettings.googleMapsLink %}
        <a href="{{ contactSettings.googleMapsLink }}" target="_blank" class="open-map-link">
          <i class="fas fa-directions"></i> Get Directions
        </a>
        {% endif %}
      </div>
      <div>
        <div class="map-container">
          {% if contactSettings.googleMapsEmbed %}
            {{ contactSettings.googleMapsEmbed | safe }}
          {% else %}
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d255282.35853743783!2d36.68219667531816!3d-1.3028611!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x182f1172d84d49a7%3A0xf7cf0254b297924c!2sNairobi%2C%20Kenya!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          {% endif %}
        </div>
        <div style="text-align:center; margin-top: 0.5rem; font-size: 0.9rem; color: #999;">
          <i class="fas fa-info-circle"></i> Map location updated by admin
        </div>
      </div>
    </div>
    <div style="background: #f8f9fa; padding: 2rem; border-radius: 12px; border-left: 4px solid #C9A87C; margin-top: 2rem;">
      <h2 style="text-align: center; margin-bottom: 1.5rem;">Send Us a Message</h2>
      <form style="max-width: 500px; margin: 0 auto;">
        <input type="text" placeholder="Your Name" required>
        <input type="email" placeholder="Your Email" required>
        <input type="tel" placeholder="Phone Number (optional)">
        <select><option value="">How can we help?</option><option value="individual">Individual Therapy</option><option value="couples">Couples Counseling</option><option value="youth">Youth Therapy</option><option value="trauma">Trauma Counseling</option><option value="grief">Grief Counseling</option><option value="anxiety">Anxiety & Depression</option><option value="other">Other</option></select>
        <textarea placeholder="Tell us what's on your heart..." rows="5" required></textarea>
        <button type="submit">Send Message</button>
      </form>
    </div>
    <div style="margin-top: 2rem; padding: 1.5rem; background: #fff8e6; border-radius: 12px; text-align: center;">
      <p><i class="fas fa-exclamation-triangle" style="color: #C9A87C;"></i> <strong>Immediate Support:</strong> Call {{ contactSettings.crisisHotline or '1190' }} for Kenya Mental Health Hotline</p>
    </div>
  </div>
</section>
{% endblock %}
