{% extends "base.njk" %}

{% block title %}About Us - Nairobi Counseling Center{% endblock %}

{% block content %}
<section class="about-page">
  <h1>About Nairobi Counseling Center</h1>
  <div style="max-width: 800px; margin: 2rem auto;">
    <p style="font-size: 1.1rem; margin-bottom: 1.5rem;">Welcome to Nairobi Counseling Center, your trusted partner in mental wellness and personal growth.</p>
    
    <p style="margin-bottom: 1.5rem;">We provide professional, compassionate counseling services in a safe and confidential environment. Our team of licensed counselors is dedicated to helping you navigate life's challenges and achieve emotional well-being.</p>
    
    <h2 style="color: #D4AF37; margin-top: 2rem;">Our Mission</h2>
    <p style="margin-bottom: 1.5rem;">To provide accessible, high-quality mental health support that empowers individuals, couples, and families to thrive.</p>
    
    <h2 style="color: #D4AF37; margin-top: 2rem;">Our Values</h2>
    <ul style="list-style: none; padding: 0;">
      <li style="padding: 0.5rem 0; border-bottom: 1px solid #eee;">✓ Confidentiality & Trust</li>
      <li style="padding: 0.5rem 0; border-bottom: 1px solid #eee;">✓ Evidence-Based Practice</li>
      <li style="padding: 0.5rem 0; border-bottom: 1px solid #eee;">✓ Cultural Sensitivity</li>
      <li style="padding: 0.5rem 0; border-bottom: 1px solid #eee;">✓ Compassionate Care</li>
      <li style="padding: 0.5rem 0;">✓ Accessibility & Affordability</li>
    </ul>
    
    <h2 style="color: #D4AF37; margin-top: 2rem;">Why Choose Us</h2>
    <ul style="list-style: none; padding: 0;">
      <li style="padding: 0.5rem 0; border-bottom: 1px solid #eee;">✓ Licensed and experienced counselors</li>
      <li style="padding: 0.5rem 0; border-bottom: 1px solid #eee;">✓ Wide range of therapeutic services</li>
      <li style="padding: 0.5rem 0; border-bottom: 1px solid #eee;">✓ Convenient location in Nairobi</li>
      <li style="padding: 0.5rem 0; border-bottom: 1px solid #eee;">✓ Flexible scheduling including evenings</li>
      <li style="padding: 0.5rem 0; border-bottom: 1px solid #eee;">✓ Online and in-person sessions available</li>
      <li style="padding: 0.5rem 0;">✓ Affordable rates and insurance options</li>
    </ul>
  </div>
</section>
{% endblock %}
