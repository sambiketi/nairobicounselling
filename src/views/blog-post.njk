{% extends "base.njk" %}

{% block title %}{{ post.title }} - Massage Nairobi{% endblock %}

{% block content %}
<section class="blog-post-page">
  <article class="blog-post">
    <h1>{{ post.title }}</h1>
    <div class="post-meta">
      <span class="date">{{ post.publishedAt }}</span>
      {% if post.author %}
      <span class="author">By {{ post.author }}</span>
      {% endif %}
    </div>
    {% if post.imageUrl %}
    <img src="{{ post.imageUrl }}" alt="{{ post.title }}" class="post-image">
    {% endif %}
    <div class="post-content">
      {{ post.content | safe }}
    </div>
  </article>
</section>
{% endblock %}
