{% extends "base.njk" %}

{% block title %}Our Counselors - Nairobi Counseling Center{% endblock %}

{% block content %}
<section class="therapists-page">
  <h1>You Are Not Alone</h1>
  <p style="text-align:center; color: #666; margin-bottom: 2rem;">Compassionate, licensed professionals who believe in your healing</p>
  
  <div class="counselors-message" style="text-align:center; padding: 2rem; background: #f8f9fa; border-radius: 12px; margin-bottom: 2rem; border-left: 4px solid #D4AF37;">
    <p style="font-size: 1.2rem; color: #333;">"We don't just treat symptoms — we walk with you through your journey to wholeness."</p>
  </div>

  <div class="therapists-grid">
    {% if counselors and counselors.length > 0 %}
      {% for counselor in counselors %}
        <div class="therapist-card">
          <h3>{{ counselor.name }}</h3>
          {% if counselor.title %}
            <p style="color: #D4AF37;">{{ counselor.title }}</p>
          {% endif %}
          {% if counselor.bio %}
            <p style="color: #666;">{{ counselor.bio }}</p>
          {% endif %}
          {% if counselor.specialties and counselor.specialties.length > 0 %}
            <div class="specialties">
              {% for specialty in counselor.specialties %}
                <span class="badge">{{ specialty }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      <p style="grid-column: 1/-1; text-align: center; color: #666;">No counselors available at this time. Please check back soon.</p>
    {% endif %}
  </div>

  <div style="text-align:center; margin-top: 3rem; padding: 2rem; background: linear-gradient(135deg, #f5f0e1, #fff8f0); border-radius: 12px;">
    <p style="font-size: 1.1rem; color: #333;">You don't have to face this alone. <strong style="color: #D4AF37;">We're here for you.</strong></p>
    <button class="book-now" onclick="openBooking()" style="margin-top: 1rem;">Start Your Healing Journey</button>
  </div>
</section>
{% endblock %}
