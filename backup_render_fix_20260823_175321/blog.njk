{% extends "base.njk" %}

{% block title %}Resources - Nairobi Counseling Center{% endblock %}

{% block content %}
<section class="blog-page">
  <h1>Resources for Your Healing Journey</h1>
  <p style="text-align:center; color: #666; margin-bottom: 2rem;">Articles, tips, and information to support your mental wellness</p>
  
  <div style="text-align:center; padding: 1.5rem; background: #f8f9fa; border-radius: 12px; margin-bottom: 2rem; border-left: 4px solid #D4AF37;">
    <p style="font-size: 1.1rem; color: #333;">"Knowledge is the first step toward healing. You are already on your way."</p>
  </div>

  <div class="blog-grid">
    {% if posts and posts.length > 0 %}
      {% for post in posts %}
        <div class="blog-card">
          {% if post.imageUrl %}
            <div class="blog-card-image-wrapper">
              <img src="{{ post.imageUrl }}" alt="{{ post.title }}" class="blog-card-image" loading="lazy" onerror="this.style.display='none'">
            </div>
          {% endif %}
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span><i class="far fa-calendar-alt"></i> {{ post.publishedAt or "August 2026" }}</span>
            </div>
            <h3>{{ post.title }}</h3>
            {% if post.excerpt %}
              <p class="blog-card-excerpt">{{ post.excerpt }}</p>
            {% else %}
              <p class="blog-card-excerpt">{{ post.content | truncate(120) if post.content else "Read this resource to learn more." }}</p>
            {% endif %}
            <div class="hope-tag">"Knowledge is power"</div>
            <a href="/blog/{{ post.slug }}" class="blog-read-more">Read More <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div style="grid-column: 1/-1; text-align: center; padding: 3rem; color: #999;">
        <i class="fas fa-book-open" style="font-size: 3rem; display: block; margin-bottom: 1rem;"></i>
        <p>No resources available yet. Check back soon!</p>
      </div>
    {% endif %}
  </div>
</section>
{% endblock %}
